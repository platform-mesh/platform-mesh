{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":gitSignOff"
  ],
  "branchPrefix": "deps/",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "prCreation": "immediate",
  "dependencyDashboard": false,
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "autoApprove": false,
  "rebaseWhen": "conflicted",
  "osvVulnerabilityAlerts": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**"
  ],
  "ignoreDeps": [
    "github.com/kcp-dev/multicluster-provider",
    "github.com/kcp-dev/multicluster-provider/client",
    "k8s.io/api",
    "k8s.io/apiextensions-apiserver",
    "k8s.io/apimachinery",
    "k8s.io/apiserver",
    "k8s.io/client-go",
    "k8s.io/component-base",
    "k8s.io/klog/v2",
    "k8s.io/kube-openapi",
    "k8s.io/utils",
    "sigs.k8s.io/controller-runtime",
    "sigs.k8s.io/multicluster-runtime"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "**/{config,manifests,test,tests,testdata,__tests__,__fixtures__}/**/*.{yaml,yml}",
      "**/kind*.{yaml,yml}"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "**/{config,manifests,test,tests,testdata,__tests__,__fixtures__}/**/*.{yaml,yml}"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "OCM resource and tool versions have no native manager.",
      "managerFilePatterns": [
        "**/component-constructor.yaml",
        "tools/Taskfile.yaml"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:version|[A-Z0-9_]+_VERSION):\\s*[\"']?(?<currentValue>[^\"'\\s@:]+)[\"']?",
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:imageReference|helmChart):\\s*[\"']?[^\"'\\s]+:(?<currentValue>[^\"'\\s@]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Vendored Flux controllers, CRDs and RBAC must be upgraded together.",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "operators/platform-mesh-operator/test/e2e/kind/yaml/flux2-*/flux2-install.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Plain-tag pins - the regex manager cannot write digests, and chart values keep digests in a separate field.",
      "matchManagers": [
        "custom.regex",
        "helm-values"
      ],
      "pinDigests": false
    },
    {
      "description": "Local component images are stamped by the release process, in chart values and in the manifests alike.",
      "matchPackageNames": [
        "ghcr.io/platform-mesh/**",
        "platform-mesh/**"
      ],
      "enabled": false
    },
    {
      "description": "k8s release-train riders: they move only when the kcp train moves.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/kcp-dev/kubernetes{/,}**",
        "github.com/kcp-dev/multicluster-provider{/,}**",
        "k8s.io/**",
        "sigs.k8s.io/**"
      ],
      "enabled": false
    },
    {
      "description": "controller-gen's version is derived from go.mod, so it has to move on its own.",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "go.mod"
      ],
      "matchPackageNames": [
        "sigs.k8s.io/controller-tools"
      ],
      "enabled": true
    },
    {
      "description": "kustomize release tags carry a prefix: kustomize/vX.Y.Z.",
      "matchPackageNames": [
        "kubernetes-sigs/kustomize"
      ],
      "extractVersion": "^kustomize/(?<version>.+)$"
    },
    {
      "description": "kind node images must match the kube version of the kcp train; kcp 0.33.x is k8s 1.33-based.",
      "matchPackageNames": [
        "kindest/node"
      ],
      "allowedVersions": "<1.34.0"
    },
    {
      "description": "capped at the last k8s-0.36-era release; raise when the kcp train moves.",
      "matchPackageNames": [
        "github.com/openfga/openfga"
      ],
      "allowedVersions": "<1.22.0"
    },
    {
      "matchPackageNames": [
        "github.com/fluxcd/helm-controller/api"
      ],
      "allowedVersions": "<1.7.0"
    },
    {
      "matchPackageNames": [
        "github.com/fluxcd/source-controller/api"
      ],
      "allowedVersions": "<1.10.0"
    },
    {
      "description": "opensearch-go v5 is a breaking migration (search-operator code changes), needs manual bump.",
      "matchPackageNames": [
        "github.com/opensearch-project/opensearch-go/v4"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "flux2 chart >=2.18 ships Flux v2.8 (Helm v4 SSA), which rejects the null fields the published platform charts render, raise after the released charts render null-free.",
      "matchPackageNames": [
        "ghcr.io/fluxcd-community/charts/flux2"
      ],
      "allowedVersions": "<2.18.0"
    },
    {
      "description": "ocm-k8s-toolkit >=0.18 drops Component.spec.verify, migrate installation.yaml and then update.",
      "matchPackageNames": [
        "ghcr.io/open-component-model/kubernetes/controller/chart"
      ],
      "allowedVersions": "<0.18.0"
    },
    {
      "description": "cel-go v0.32+ renamed its module to cel.dev/cel-go; switching is a code migration.",
      "matchPackageNames": [
        "github.com/google/cel-go"
      ],
      "allowedVersions": "<0.32.0"
    },
    {
      "description": "Allow pre-release updates for OCM component",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "**/ocm/component.yaml",
        "**/ocm-k8s-toolkit/ocm-k8s-toolkit.yaml"
      ],
      "ignoreUnstable": false
    }
  ]
}
