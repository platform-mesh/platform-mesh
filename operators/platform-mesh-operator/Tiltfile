load("../../contrib/tilt/lib/component.Tiltfile", "component")
load("../../contrib/tilt/lib/helpers.py", "IMAGE_PREFIX", "chart", "component_binary", "select_objects", "writable_rootfs", "write_values")
load("../../contrib/tilt/lib/settings.Tiltfile", "GO_DEPS", "KCP_FRONT_PROXY_URL", "NAMESPACE", "PORT")


def _deploy(c, ctx):
    image = IMAGE_PREFIX + c.name
    component_binary(c.name, "operators/platform-mesh-operator", deps=GO_DEPS, image=image, labels=[c.group])

    # ocm.enabled=false renders only the operator (no OCM/Flux objects,
    # PlatformMesh or profile) and drops the kcp flags and CA mount, which
    # are added back here.
    blob = chart(
        c.name,
        NAMESPACE,
        values=[
            write_values(
                c.name,
                {
                    "ocm": {"enabled": False},
                    "log": {"level": "debug"},
                    "extraArgs": [
                        "--subroutines-feature-toggles-enabled=true",
                        "--kcp-front-proxy-port={}".format(PORT),
                        "--kcp-url=" + KCP_FRONT_PROXY_URL,
                    ],
                    "extraEnvs": [{"name": "SSL_CERT_FILE", "value": "/etc/platform-mesh-ca/ca.crt"}],
                    "extraVolumeMounts": [
                        {"name": "platform-mesh-ca", "mountPath": "/etc/platform-mesh-ca", "readOnly": True}
                    ],
                    "extraVolumes": [
                        {
                            "name": "platform-mesh-ca",
                            "secret": {
                                "secretName": "domain-certificate",
                                "optional": True,
                                "items": [{"key": "ca.crt", "path": "ca.crt"}],
                            },
                        }
                    ],
                },
            )
        ],
    )
    blob = writable_rootfs(blob, image)
    k8s_yaml(blob)
    k8s_resource(
        c.name,
        objects=select_objects(blob, lambda o: True),
        resource_deps=ctx.deps,
        labels=[c.group],
    )


# Hot-reloaded, OCM off, empty profile (contrib/tilt/manifests/platformmesh.yaml):
# Tilt deploys every chart itself, the operator only does the kcp glue.
#
# Does not need kcp: the root shard only starts once PMO has written
# kcp-webhook-secret, and PMO's kcp setup retries until the front proxy answers.
COMPONENT = component(
    name="platform-mesh-operator",
    group="core",
    needs=["kcp-operator", "domain-certificate", "ocm-crds"],
    runtime=_deploy,
)
