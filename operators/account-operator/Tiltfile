load("../../contrib/tilt/lib/component.Tiltfile", "component", "go_service")
load("../../contrib/tilt/lib/settings.Tiltfile", "DEX_CLIENT_ID", "DEX_ISSUER", "DEX_KUBECTL_SCOPES")


def _deploy(c, ctx):
    overrides = {}
    if ctx.selected("dex"):
        # What platform-mesh-operator derives from spec.authentication.oidc: the
        # issuer every AccountInfo has, read by the portal for its kubeconfigs.
        overrides["oidc"] = {
            "issuerUrl": DEX_ISSUER,
            "clients": {"kubectl": DEX_CLIENT_ID},
            "scopes": DEX_KUBECTL_SCOPES,
        }
    return go_service(path="operators/account-operator", overrides=overrides)(c, ctx)


COMPONENT = component(
    name="account-operator",
    group="core",
    needs=["platform-mesh-operator"],
    alongside=["platformmesh"],
    runtime=_deploy,
)
