load("../../contrib/tilt/lib/component.Tiltfile", "component")
load("../../contrib/tilt/lib/helpers.py", "IMAGE_PREFIX", "chart", "component_binary", "select_objects", "writable_rootfs", "write_values")
load("../../contrib/tilt/lib/settings.Tiltfile", "GO_DEPS", "NAMESPACE")


def _deploy(c, ctx):
    image = IMAGE_PREFIX + c.name
    component_binary(c.name, "operators/sdk-access-operator", deps=GO_DEPS, image=image, labels=[c.label])

    # Not in the kind profile: the sdk-access CRDs come in as a subchart
    # of this release, and leader election is off because the chart runs
    # a single replica.
    blob = chart(
        c.name,
        NAMESPACE,
        values=[
            write_values(
                c.name,
                {
                    "crds": {"enabled": True},
                    "operator": {"leaderElect": False},
                },
            )
        ],
    )
    blob = writable_rootfs(blob, image)
    k8s_yaml(blob)
    k8s_resource(
        c.name,
        objects=select_objects(blob, lambda o: True),
        resource_deps=ctx.deps,
        labels=[c.label],
    )


# sdk-access-operator is a remote-side RFC 016 component. It only runs
# in the e2e stack ("e2e" group in contrib/tilt/groups.Tiltfile) so the
# tests/e2e/access suite can treat PM's own runtime cluster as the
# "remote cluster". Not in the kind profile: the regular stack does not
# need it.
COMPONENT = component(
    name="sdk-access-operator",
    label="e2e",
    needs=["platform-mesh-operator"],
    runtime=_deploy,
)
