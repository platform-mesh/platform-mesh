load("../../contrib/tilt/lib/component.Tiltfile", "component", "go_service")

# sdk-access-operator is a remote-side component (RFC 016). Not part of
# the kind profile; brought up by the "e2e" group so `task tilt:ci` (and
# therefore the tests/e2e/access suite) sees it, while `task tilt:up`
# leaves it out. crds.enabled is on because the kind profile does not
# install sdk-access-crds separately.
COMPONENT = component(
    name="sdk-access-operator",
    label="extern",
    needs=["platform-mesh-operator"],
    runtime=go_service(
        path="operators/sdk-access-operator",
        overrides={
            "crds": {"enabled": True},
            "operator": {"leaderElect": False},
        },
    ),
)
