load("../../contrib/tilt/lib/component.Tiltfile", "component")
load("../../contrib/tilt/lib/helpers.py", "IMAGE_PREFIX", "chart", "component_binary", "select_objects", "writable_rootfs", "write_values")
load("../../contrib/tilt/lib/settings.Tiltfile", "GO_DEPS", "NAMESPACE", "PORT")


def _deploy(c, ctx):
    image = IMAGE_PREFIX + c.name
    component_binary(c.name, "operators/provider-operator", deps=GO_DEPS, image=image, labels=[c.label])

    # Not go_service: the kind profile has no entry for this chart.
    blob = chart(
        c.name,
        NAMESPACE,
        values=[write_values(c.name, {"kcp": {"frontProxyPort": PORT}, "log": {"level": "debug"}})],
    )
    blob = writable_rootfs(blob, image)
    k8s_yaml(blob)
    k8s_resource(
        c.name,
        objects=select_objects(blob, lambda o: True),
        resource_deps=ctx.deps,
        labels=[c.label],
    )


# Opt-in (--with=provider-operator): reconciles ManagedProviders instead of
# platform-mesh-operator.
COMPONENT = component(
    name="provider-operator",
    label="core",
    needs=["platform-mesh-operator"],
    alongside=["platformmesh"],
    runtime=_deploy,
)
