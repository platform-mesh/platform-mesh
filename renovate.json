{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "mergeConfidence:all-badges",
    "local>platform-mesh/.github:renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in tools/Taskfile.yaml",
      "managerFilePatterns": [
        "/(^|/)tools/Taskfile\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z0-9_]+_VERSION:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Third-party versions shipped with Platform Mesh (ocm/versions.yaml)",
      "managerFilePatterns": [
        "/(^|/)ocm/versions\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n[A-Z0-9_]+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Allow pre-release updates for OCM component",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "**/ocm/component.yaml",
        "**/ocm-k8s-toolkit/ocm-k8s-toolkit.yaml"
      ],
      "ignoreUnstable": false
    }
  ]
}
