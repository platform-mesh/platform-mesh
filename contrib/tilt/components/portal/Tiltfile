load("../../lib/component.Tiltfile", "chart_service", "component")
load("../../lib/helpers.py", "profile_values")
load(
    "../../lib/settings.Tiltfile",
    "DEX_CLIENT_ID",
    "DEX_CLIENT_SECRET",
    "DEX_ISSUER",
    "DEX_SCOPES",
    "PORT",
    "TEMPLATE_VARS",
)


def _deploy(c, ctx):
    overrides = {"frontendPort": str(PORT)}
    if ctx.selected("dex"):
        overrides["auth"] = {"default": {"discoveryUrl": DEX_ISSUER + "/.well-known/openid-configuration"}}
        overrides["extraEnvVars"] = profile_values("portal", TEMPLATE_VARS).get("extraEnvVars", []) + [
            {"name": "OIDC_STATIC_CLIENT_ID", "value": DEX_CLIENT_ID},
            {"name": "OIDC_STATIC_CLIENT_SECRET", "value": DEX_CLIENT_SECRET},
            {"name": "OIDC_SCOPE", "value": " ".join(DEX_SCOPES)},
            # Dex has no wildcard redirect URIs; only the base domain's callback is registered.
            {"name": "OIDC_CALLBACK_ON_BASE_DOMAIN", "value": "true"},
        ]
    return chart_service(overrides=overrides)(c, ctx)


COMPONENT = component(
    name="portal",
    label="ui",
    needs=["platform-mesh-operator"],
    alongside=["platformmesh"],
    runtime=_deploy,
)
