load("../../lib/component.Tiltfile", "component", "export_secret")

# Credentials exported to the host (.secret/ is gitignored).
COMPONENTS = [
    component(
        name="export-ca",
        label="dev",
        needs=["domain-certificate"],
        runtime=export_secret("domain-certificate", "ca.crt", ".secret/ca.crt"),
    ),
    component(
        name="export-kcp-ca",
        label="dev",
        needs=["kcp"],
        runtime=export_secret("root-ca", "tls.crt", ".secret/kcp-root-ca.crt"),
    ),
    component(
        name="export-kcp-admin-kubeconfig",
        label="dev",
        needs=["kcp"],
        runtime=export_secret("kubeconfig-kcp-admin", "kubeconfig", ".secret/kcp-admin.kubeconfig"),
    ),
]
