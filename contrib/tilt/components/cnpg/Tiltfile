load("../../lib/component.Tiltfile", "component")
load("../../lib/helpers.py", "named", "write_yaml")
load("../../lib/infra.Tiltfile", "infra_blob")
load("../../lib/prereq.Tiltfile", "PREREQ_RELEASE", "prereq_workload")
load("../../lib/settings.Tiltfile", "KUBECTL")


def _webhook_answers(ctx):
    """The cnpg Deployment is Ready before its webhook server listens; a server-side
    dry run of the infra chart's own Database is the one probe that goes through it."""
    databases = [o for o in decode_yaml_stream(infra_blob(ctx)) if o["kind"] == "Database"]
    if not databases:
        return "true"
    probe = write_yaml(".cache/probe-cnpg.yaml", databases[0])
    return "for i in $(seq 60); do {k} apply --dry-run=server -f {f} && exit 0; sleep 2; done; exit 1".format(
        k=KUBECTL, f=probe
    )


# The CloudNativePG operator.
COMPONENT = component(
    name="cnpg",
    group="prereq",
    needs=["namespace"],
    runtime=prereq_workload(
        PREREQ_RELEASE + "cloudnative-pg",
        objects=lambda o: named("cnpg")(o) or named("cloudnative-pg")(o),
    ),
    ready=[_webhook_answers],
)
