load("../../lib/component.Tiltfile", "component")
load("../../lib/infra.Tiltfile", "infra_blob")
load("../../lib/helpers.py", "select_objects")


def _deploy(c, ctx):
    # The Deployment and Service come with the infra chart once dex is selected
    # (lib/infra.Tiltfile enables it); the ConfigMap is grouped with them.
    k8s_resource(
        "dex",
        objects=select_objects(
            infra_blob(ctx), lambda o: o["kind"] == "ConfigMap" and o["metadata"]["name"] == "dex"
        ),
        resource_deps=ctx.deps,
        labels=[c.group],
    )


# Dex with static users as identity provider of kcp, instead of Keycloak:
# `task tilt:up -- --with=dex`. Selecting it also points kcp
# (lib/infra.Tiltfile), the PlatformMesh and the portal at it.
COMPONENT = component(
    name="dex",
    group="infra",
    needs=["gateway"],
    runtime=_deploy,
)
