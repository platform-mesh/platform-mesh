load("../../lib/component.Tiltfile", "chart_objects", "component", "wait")
load("../../lib/infra.Tiltfile", "KCP_API_HOSTNAME")
load("../../lib/settings.Tiltfile", "PORT")

# The MCP virtual workspace (kcp-dev/contrib-virtual-workspaces): an MCP server
# over the workspaces a caller may access, at /services/mcp of the front proxy
# (lib/infra.Tiltfile adds the route). Sessions are scoped through the access
# virtual workspace.
#
# Not set up here: native OIDC validation (oidc.*, oauth.* of the chart) and
# the mcp-virtual-workspace-impersonator ClusterRole the server needs in every
# workspace it should act in; see charts/kcp-mcp-vw/README.md.
COMPONENT = component(
    name="kcp-mcp-vw",
    label="api",
    needs=["kcp-gateway", "kcp-access-vw"],
    runtime=chart_objects(
        values={
            "external": {"hostname": KCP_API_HOSTNAME, "port": PORT},
            "resources": {"requests": {"cpu": "1m", "memory": "1Mi"}},
        },
    ),
    ready=[wait("virtualworkspace/mcp-vw", "condition=Available", timeout="10m")],
)
