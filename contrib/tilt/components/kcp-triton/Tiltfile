load("../../lib/component.Tiltfile", "component", "gate", "wait")

_SHARD = "shards.operator.kcp.io/triton"


def _deploy(c, ctx):
    # The Shard only needs the kcp objects applied, so it starts next to the
    # root shard instead of after it.
    k8s_resource(
        new_name=c.name,
        objects=["triton:shard"],
        resource_deps=[ctx.deployed("kcp")],
        labels=[c.label],
        pod_readiness="ignore",
    )
    gate(
        c.name + "-ready",
        [wait(_SHARD, "create"), wait(_SHARD, "condition=Available", timeout="15m")],
        [c.name] + ctx.deps,
        c.label,
    )
    return c.name + "-ready"


# Second kcp shard, exercised by the e2e tests only.
COMPONENT = component(
    name="kcp-triton",
    label="e2e",
    needs=["kcp"],
    runtime=_deploy,
)
