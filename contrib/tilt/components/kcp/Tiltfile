load("../../lib/component.Tiltfile", "component", "wait")
load("../../lib/helpers.py", "kind_in", "select_objects")
load("../../lib/infra.Tiltfile", "infra_blob")


def _deploy(c, ctx):
    k8s_resource(
        new_name="kcp",
        objects=select_objects(
            infra_blob(ctx), kind_in(["FrontProxy", "CacheServer", "Etcd", "Kubeconfig", "Issuer", "Certificate"])
        ),
        resource_deps=ctx.deps,
        labels=[c.group],
    )
    k8s_resource(
        new_name="kcp-root", objects=["root:rootshard"], resource_deps=["kcp"], labels=[c.group], pod_readiness="ignore"
    )
    return "kcp-root"


# kcp: root shard, front proxy, cache server and their etcds, run by kcp-operator.
COMPONENT = component(
    name="kcp",
    group="infra",
    needs=["kcp-operator", "etcd-druid", "domain-certificate"],
    runtime=_deploy,
    # Wait on operator conditions because bootstrap replaces kcp pods.
    ready=[wait("rootshard/root frontproxy/frontproxy", "condition=Available", timeout="15m")],
)
