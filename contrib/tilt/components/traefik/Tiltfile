load("../../lib/component.Tiltfile", "component")
load("../../lib/helpers.py", "kind_in", "named", "select_objects", "suffixed")
load("../../lib/prereq.Tiltfile", "PREREQ_RELEASE", "prereq_blob")

_is_gateway_crd = lambda o: o["kind"] == "CustomResourceDefinition" and (
    named(".gateway.networking.")(o) or suffixed("traefik.io")(o)
)
_is_gatewayclass = kind_in(["GatewayClass"])
_is_traefik = lambda o: (
    named("traefik")(o) and not _is_gateway_crd(o) and not _is_gatewayclass(o)
) or o["kind"] == "IngressClass"


def _deploy(c, ctx):
    blob = prereq_blob(ctx)

    # Gateway API and Traefik CRDs, both from the traefik-crds subchart.
    k8s_resource(new_name="gateway-crds", objects=select_objects(blob, _is_gateway_crd), labels=[c.group])
    k8s_resource(
        PREREQ_RELEASE + "traefik",
        new_name="traefik",
        objects=select_objects(blob, _is_traefik),
        resource_deps=ctx.deps + ["gateway-crds"],
        labels=[c.group],
    )

    # Applied once traefik is up: right after gateway-crds the Gateway kinds are
    # not always discoverable yet and the apply fails with "no matches for kind".
    k8s_resource(
        new_name="gatewayclass",
        objects=select_objects(blob, _is_gatewayclass),
        resource_deps=["traefik"],
        labels=[c.group],
    )
    return "gatewayclass"


# The gateway controller behind every hostname, on the kind node's NodePort.
COMPONENT = component(
    name="traefik",
    group="prereq",
    needs=["namespace"],
    runtime=_deploy,
)
