load("../../lib/component.Tiltfile", "component")
load("../../lib/infra.Tiltfile", "KCP_API_HOSTNAME", "KCP_ROOT_HOSTNAME", "KCP_TRITON_HOSTNAME")
load("../../lib/settings.Tiltfile", "PORT")

_ATTEMPTS = 60
_RETRY_SECONDS = 5


def _answers(ctx):
    hostnames = [KCP_API_HOSTNAME, KCP_ROOT_HOSTNAME] + ([KCP_TRITON_HOSTNAME] if ctx.selected("kcp-triton") else [])
    return (
        "for url in {urls}; do curl -fsS --cacert .secret/kcp-root-ca.crt --retry {attempts} --retry-delay {retry} --retry-all-errors \"$url\" || exit 1; done"
    ).format(
        urls=" ".join(["https://{}:{}/readyz".format(h, PORT) for h in hostnames]),
        attempts=_ATTEMPTS,
        retry=_RETRY_SECONDS,
    )


# kcp reachable from the host through the gateway. Only a gate: kcp needs
# time to set up and sync, the gateway controller to program the routes.
COMPONENT = component(
    name="kcp-gateway",
    label="infra",
    needs=["kcp", "gateway", "export-kcp-ca"],
    ready=[_answers],
)
