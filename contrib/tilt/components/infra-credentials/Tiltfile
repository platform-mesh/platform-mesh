load("../../lib/component.Tiltfile", "component", "wait")
load("../../lib/infra.Tiltfile", "infra_objects")

# Tilt applies Helm hooks directly; wait for credentials before PostgreSQL.
COMPONENT = component(
    name="infra-credentials",
    label="infra",
    needs=["namespace"],
    runtime=infra_objects(workload="infra-credentials-bootstrap"),
    ready=[wait("job/infra-credentials-bootstrap", "condition=Complete", timeout="3m")],
)
