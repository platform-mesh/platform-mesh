load("../../lib/component.Tiltfile", "component")
load("../../lib/helpers.py", "kind_in")
load("../../lib/prereq.Tiltfile", "prereq_objects")
load("../../lib/settings.Tiltfile", "KUBECTL")

_CERTIFICATES = "certificate/platform-mesh-gateway-ca certificate/platform-mesh-gateway"

# Tilt reports the Certificates as ready once applied; wait for cert-manager to
# issue them, and on failure print why (e.g. IncorrectIssuer when a stale
# Certificate from an older install writes to the same Secret).
_ISSUED = (
    KUBECTL
    + " wait "
    + _CERTIFICATES
    + " --for=condition=Ready --timeout=5m || { "
    + KUBECTL
    + " get "
    + _CERTIFICATES
    + " -o jsonpath='{range .items[*]}{.metadata.name}: {.status.conditions[?(@.type==\"Ready\")].reason}"
    + " {.status.conditions[?(@.type==\"Ready\")].message}{\"\\n\"}{end}' >&2; exit 1; }"
)

# The local CA and the wildcard certificate of the base domain.
COMPONENT = component(
    name="domain-certificate",
    label="prereq",
    needs=["cert-manager"],
    runtime=prereq_objects(kind_in(["Issuer", "Certificate"])),
    ready=[_ISSUED],
)
