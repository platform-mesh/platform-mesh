load("./helpers.py", "chart_deps")
load("./tiltfiles/settings.Tiltfile", "CONTEXT")

allow_k8s_contexts(CONTEXT)
if config.tilt_subcommand in ("up", "ci") and k8s_context() != CONTEXT:
    fail("kube context is {}, expected {}; run contrib/tilt/kind.sh first".format(k8s_context(), CONTEXT))

watch_settings(ignore=[".cache/**", ".secret/**"])

# kind pulls third-party images on first apply; the default 30s is too short.
update_settings(k8s_upsert_timeout_secs=120)

# kcp becomes ready only after PMO has written kcp-webhook-secret, which in
# turn waits for the front proxy: the chain takes longer than the 5m default.
ci_settings(readiness_timeout="15m")

chart_deps()

include("./tiltfiles/prereq.Tiltfile")
include("./tiltfiles/infra.Tiltfile")
include("./tiltfiles/platform-mesh.Tiltfile")
include("./tiltfiles/dev.Tiltfile")
