# Platform Mesh on kind. Every component declares itself in its own Tiltfile
# (lib/component.Tiltfile has the contract); this file selects the components
# to run and deploys them:
#
#   task tilt:up                        everything but the e2e fixtures (the "ui" group)
#   task tilt:ci                        everything (the "full" group)
#   task tilt:up -- core                a group (groups.Tiltfile)
#   task tilt:up -- core iam-service    groups and single components
#   task tilt:up -- --without=keycloak  leave a component and its dependents out
#   task tilt:up -- --with=dex          add Dex as identity provider, without Keycloak

load("./groups.Tiltfile", "GROUPS", "DEFAULT_CI", "DEFAULT_UP")
load("./lib/component.Tiltfile", "deploy", "expand", "select")
load("./lib/helpers.py", "REPO", "chart_deps")
load("./lib/settings.Tiltfile", "CONTEXT", "WANTED", "WITH", "WITHOUT")

allow_k8s_contexts(CONTEXT)
if config.tilt_subcommand in ("up", "ci") and k8s_context() != CONTEXT:
    fail("kube context is {}, expected {}; run `task tilt:up` (or hack/kind.sh up) first".format(k8s_context(), CONTEXT))

watch_settings(ignore=[".cache/**", ".secret/**"])

# kind pulls third-party images on first apply; the default 30s is too short.
update_settings(k8s_upsert_timeout_secs=120)

# kcp becomes ready only after PMO has written kcp-webhook-secret, which in
# turn waits for the front proxy: the chain takes longer than the 5m default.
ci_settings(readiness_timeout="15m")

chart_deps()

# Components live next to their code, or in components/ when there is none here.
components = {}
tiltfiles = str(
    local(
        "ls operators/*/Tiltfile services/*/Tiltfile contrib/tilt/components/*/Tiltfile",
        dir=REPO,
        quiet=True,
        echo_off=True,
    )
).split()
for path in tiltfiles:
    symbols = load_dynamic(os.path.join(REPO, path))
    declared = symbols.get("COMPONENTS", []) + ([symbols["COMPONENT"]] if "COMPONENT" in symbols else [])
    if not declared:
        fail("{} declares no COMPONENT".format(path))
    for c in declared:
        if c.name in components:
            fail("{}: component {} is declared twice".format(path, c.name))
        components[c.name] = c

default = DEFAULT_CI if config.tilt_subcommand == "ci" else DEFAULT_UP
selected = select(components, expand((WANTED or default) + WITH, GROUPS), WITHOUT)
print("components: " + " ".join(selected))
deploy(components, selected)
