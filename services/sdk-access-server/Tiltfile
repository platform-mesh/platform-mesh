load("../../contrib/tilt/lib/component.Tiltfile", "component", "go_service")

# sdk-access-server is a remote-side component (RFC 016). Not part of
# the kind profile; brought up by the "e2e" group so `task tilt:ci` (and
# therefore the tests/e2e/access suite) sees it, while `task tilt:up`
# leaves it out. TLS is off so access-operator reaches it over plain
# HTTP on the in-cluster Service without cert-manager wiring.
COMPONENT = component(
    name="sdk-access-server",
    label="extern",
    needs=["sdk-access-operator"],
    runtime=go_service(
        path="services/sdk-access-server",
        overrides={
            "tls": {"enabled": False},
            "service": {"type": "ClusterIP"},
        },
    ),
)
