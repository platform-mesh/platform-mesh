load("../../contrib/tilt/lib/component.Tiltfile", "chart_objects", "component", "go_service")
load("../../contrib/tilt/lib/helpers.py", "kind_in")

COMPONENTS = [
    # The ClusterAccess CRD (charts/kubernetes-graphql-gateway-crds). A component
    # of its own because other charts ship ClusterAccess objects
    # (marketplace) and must not wait for the gateway to be running.
    component(
        name="kubernetes-graphql-gateway-crds",
        label="api",
        runtime=chart_objects(),
    ),
    component(
        name="kubernetes-graphql-gateway",
        label="api",
        needs=["platform-mesh-operator", "kubernetes-graphql-gateway-crds", "gateway"],
        alongside=["platformmesh"],
        runtime=go_service(
            path="services/kubernetes-graphql-gateway",
            workloads=["kubernetes-graphql-gateway", "kubernetes-graphql-gateway-listener"],
            # Deployed by the component above. Not crds.enabled=false: that
            # also drops the ClusterAccess rules from the ClusterRole.
            exclude=kind_in(["CustomResourceDefinition"]),
        ),
    ),
]
