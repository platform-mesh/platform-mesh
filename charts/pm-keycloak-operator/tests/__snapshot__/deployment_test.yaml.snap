operator matches the snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: RELEASE-NAME-pm-keycloak-operator
    rules:
      - apiGroups:
          - coordination.k8s.io
        resources:
          - leases
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - ""
        resources:
          - events
          - secrets
        verbs:
          - '*'
      - apiGroups:
          - helm.toolkit.fluxcd.io
        resources:
          - helmreleases
        verbs:
          - get
          - list
          - watch
          - create
          - delete
          - update
          - patch
      - apiGroups:
          - source.toolkit.fluxcd.io
        resources:
          - ocirepositories
          - helmreleases
        verbs:
          - get
          - list
          - create
          - update
          - patch
          - delete
          - watch
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: RELEASE-NAME-pm-keycloak-operator
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: RELEASE-NAME-pm-keycloak-operator
    subjects:
      - kind: ServiceAccount
        name: RELEASE-NAME-pm-keycloak-operator
        namespace: NAMESPACE
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: RELEASE-NAME-pm-keycloak-operator
      namespace: NAMESPACE
    spec:
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app: RELEASE-NAME-pm-keycloak-operator
      template:
        metadata:
          labels:
            app: RELEASE-NAME-pm-keycloak-operator
            control-plane: controller-manager
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - operator
                - --user-claim=email
                - --kcp-kubeconfig=/api-kubeconfig/kubeconfig
                - --domain-ca-lookup
                - --webhooks-enabled=true
                - --webhooks-port=9443
                - --webhooks-cert-dir=/certs
                - --leader-elect
                - --metrics-bind-address=:9090
                - --health-probe-bind-address=:8090
                - --log-level=warn
                - --region=
                - --environment=
                - --image-tag=1.0.0
                - --image-name="ghcr.io/platform-mesh/platform-mesh/pm-keycloak-operator"
                - --shutdown-timeout=1m
                - --max-concurrent-reconciles=10
              env:
                - name: KEYCLOAK_CLIENT_SECRET
                  valueFrom:
                    secretKeyRef:
                      key: client_secret
                      name: pm-keycloak-operator-client-secret
              image: ghcr.io/platform-mesh/platform-mesh/pm-keycloak-operator:1.0.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 1
                httpGet:
                  path: /healthz
                  port: 8090
                periodSeconds: 10
              name: RELEASE-NAME-pm-keycloak-operator
              ports:
                - containerPort: 9090
                  name: metrics
                  protocol: TCP
                - containerPort: 8090
                  name: health-port
                  protocol: TCP
                - containerPort: 9443
                  name: webhook
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 8090
                initialDelaySeconds: 5
                periodSeconds: 10
              resources:
                limits:
                  cpu: 260m
                  memory: 512Mi
                requests:
                  cpu: 150m
                  memory: 128Mi
              securityContext:
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /readyz
                  port: 8090
                periodSeconds: 10
              volumeMounts:
                - mountPath: /api-kubeconfig
                  name: external-api-server
                - mountPath: /keycloak-credentials
                  name: keycloak-credentials
                  readOnly: true
                - mountPath: /certs
                  name: webhook-certs
                  readOnly: true
          initContainers:
            - args:
                - init-container
              image: ghcr.io/platform-mesh/platform-mesh/pm-keycloak-operator:1.0.0
              imagePullPolicy: IfNotPresent
              name: bootstrap-keycloak-clients
              resources: null
              securityContext:
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              volumeMounts:
                - mountPath: /config
                  name: init-container-config
                  readOnly: true
                - mountPath: /secrets
                  name: keycloak-password
                  readOnly: true
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: RELEASE-NAME-pm-keycloak-operator
          terminationGracePeriodSeconds: 10
          volumes:
            - configMap:
                name: RELEASE-NAME-pm-keycloak-operator-init-container-config
              name: init-container-config
            - name: keycloak-password
              secret:
                items:
                  - key: password
                    path: keycloak-password
                secretName: keycloak-admin
            - name: external-api-server
              secret:
                secretName: kcp-kubeconfig
            - name: keycloak-credentials
              secret:
                secretName: keycloak-admin
            - name: webhook-certs
              secret:
                secretName: RELEASE-NAME-pm-keycloak-operator-webhook-server-cert
  4: |
