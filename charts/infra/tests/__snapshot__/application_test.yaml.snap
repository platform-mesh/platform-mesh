match snapshots:
  1: |
    apiVersion: operator.kcp.io/v1alpha1
    kind: Kubeconfig
    metadata:
      name: kubeconfig-kcp-admin
      namespace: platform-mesh-system
    spec:
      groups:
        - system:kcp:admin
      secretRef:
        name: kubeconfig-kcp-admin
      target:
        frontProxyRef:
          name: frontproxy
      username: kcp-admin
      validity: 8766h
  2: |
    apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      name: kcp-cluster-admin-client-cert
      namespace: platform-mesh-system
    spec:
      commonName: cluster-admin
      issuerRef:
        name: root-client-ca
      privateKey:
        algorithm: RSA
        size: 2048
      secretName: kcp-cluster-admin-client-cert
      subject:
        organizations:
          - system:kcp:admin
      usages:
        - client auth
  3: |
    apiVersion: druid.gardener.cloud/v1alpha1
    kind: Etcd
    metadata:
      labels:
        app: etcd-statefulset
