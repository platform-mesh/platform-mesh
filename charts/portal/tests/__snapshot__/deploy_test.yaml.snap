matches the snapshot:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app: portal
      name: portal
    spec:
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app: portal
      strategy:
        rollingUpdate:
          maxSurge: 5
          maxUnavailable: 0
        type: RollingUpdate
      template:
        metadata:
          labels:
            app: portal
        spec:
          automountServiceAccountToken: true
          containers:
            - env:
                - name: HTTP_PROTOCOL
                  value: https
                - name: DISCOVERY_ENDPOINT
                  value: https://:443/keycloak/realms/${org-name}/.well-known/openid-configuration
                - name: OIDC_CLIENT_ID_DEFAULT
                  value: welcome
                - name: BASE_DOMAINS_DEFAULT
                  value: null
                - name: COOKIE_DOMAIN
                  value: null
                - name: FRONTEND_PORT
                  value: "443"
                - name: OPENMFP_PORTAL_CONTEXT_IAM_SERVICE_API_URL
                  value: https://${org-subdomain}:443/iam/graphql
                - name: OPENMFP_PORTAL_CONTEXT_CRD_GATEWAY_API_URL
                  value: https://${org-subdomain}:443/gateway/api/clusters/root:orgs:${org-name}/graphql
                - name: OPENMFP_PORTAL_CONTEXT_AUTHZ_WEBHOOK_URL
                  value: https://rebac-authz-webhook.NAMESPACE.svc.cluster.local:9443
                - name: NODE_EXTRA_CA_CERTS
                  value: /etc/ssl/certs/ca-bundle.crt
                - name: PORT
                  value: "443"
                - name: REGION
                  value: null
                - name: IMAGE_TAG
                  value: 1.0.0
                - name: IMAGE_NAME
                  value: ghcr.io/platform-mesh/portal
                - name: DEVELOPMENT_INSTANCE
                  value: "false"
                - name: FEATURE_TOGGLES
                  value: enableSessionAutoRefresh=true
                - name: UI_OPTIONS
                  value: enableFeatureToggleSetting
                - name: CONTENT_CONFIGURATION_VALIDATOR_API_URL
                  value: http://extension-manager-operator-server.NAMESPACE.svc.cluster.local:8088/validate
                - name: VALID_WEBCOMPONENT_URLS
                  value: .?
                - name: TEST_TEST
                  value: test test
                - name: DEMO_PORTAL_CONTEXT_CRD_GATEWAY_API_URL
                  value: https://${org-subdomain}portal.localhost:8443/api/kubernetes-graphql-gateway/root:orgs:${org-name}/graphql
                - name: DEMO_PORTAL_CONTEXT_IAM_SERVICE_API_URL
                  value: https://portal.localhost:8443/iam/query
                - name: DEMO_PORTAL_CONTEXT_IAM_ENTITY_CONFIG
                  value: '{"account":{"contextProperty":"entityId"}}'
                - name: KUBECONFIG
                  value: /kubeconfig/kubeconfig
                - name: KUBECONFIG_KCP
                  value: /kcp-kubeconfig/kubeconfig
              image: ghcr.io/platform-mesh/portal:12345
              imagePullPolicy: IfNotPresent
              name: portal
              ports:
                - containerPort: 443
                  name: http
                  protocol: TCP
                - containerPort: 9090
                  name: metrics
                  protocol: TCP
                - containerPort: 8080
                  name: health-port
                  protocol: TCP
              resources:
                limits:
                  memory: 512Mi
                requests:
                  cpu: 40m
                  memory: 50Mi
              securityContext:
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              volumeMounts:
                - mountPath: /etc/ssl/certs/ca-bundle.crt
                  name: combined-ca
                  readOnly: true
                  subPath: ca-bundle.crt
                - mountPath: /kubeconfig
                  name: kubeconfig
                - mountPath: /kcp-kubeconfig
                  name: kcp-kubeconfig
          initContainers:
            - command:
                - sh
                - -c
                - cat /domain-ca/ca.crt /webhook-ca/ca.crt > /combined-ca/ca-bundle.crt
              image: busybox:1.36
              name: combine-ca
              securityContext:
                runAsUser: 1000
              volumeMounts:
                - mountPath: /domain-ca
                  name: domain-ca
                  readOnly: true
                - mountPath: /webhook-ca
                  name: webhook-ca
                  readOnly: true
                - mountPath: /combined-ca
                  name: combined-ca
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: portal
          terminationGracePeriodSeconds: 10
          volumes:
            - name: domain-ca
              secret:
                secretName: domain-certificate
            - name: webhook-ca
              secret:
                secretName: rebac-authz-webhook-cert
            - emptyDir: {}
              name: combined-ca
            - name: kubeconfig
              secret:
                secretName: my-kubeconfig-secret
            - name: kcp-kubeconfig
              secret:
                secretName: my-kcp-kubeconfig-secret
