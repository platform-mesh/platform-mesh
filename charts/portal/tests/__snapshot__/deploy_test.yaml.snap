                  name: combined-ca
                  readOnly: true
                  subPath: ca-bundle.crt
                - mountPath: /kcp-kubeconfig
                  name: kcp-kubeconfig
          hostAliases:
            - hostnames:
                - example.com
                - test.example.com
              ip: 10.0.0.1
          initContainers:
            - command:
                - sh
                - -c
                - cat /domain-ca/ca.crt /webhook-ca/ca.crt > /combined-ca/ca-bundle.crt
              image: busybox:1.36
