operator matches the snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: provider-operator
    rules:
      - apiGroups:
          - ""
        resources:
          - namespaces
        verbs:
          - create
      - apiGroups:
          - ""
        resources:
          - secrets
        verbs:
          - create
          - delete
          - get
          - update
      - apiGroups:
          - delivery.ocm.software
        resources:
          - components
          - repositories
          - resources
        verbs:
          - create
          - delete
          - get
          - update
      - apiGroups:
          - helm.toolkit.fluxcd.io
        resources:
          - helmreleases
        verbs:
          - create
          - delete
          - get
          - update
      - apiGroups:
          - providers.platform-mesh.io
        resources:
          - managedproviders
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - providers.platform-mesh.io
        resources:
          - managedproviders/finalizers
        verbs:
          - update
      - apiGroups:
          - providers.platform-mesh.io
        resources:
          - managedproviders/status
        verbs:
          - get
          - patch
          - update
      - apiGroups:
          - source.toolkit.fluxcd.io
        resources:
          - helmrepositories
          - ocirepositories
        verbs:
          - create
          - delete
          - get
          - update
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: provider-operator
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: provider-operator
    subjects:
      - kind: ServiceAccount
        name: provider-operator
        namespace: platform-mesh-system
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: provider-operator
      namespace: platform-mesh-system
    spec:
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app: provider-operator
      template:
        metadata:
          labels:
            app: provider-operator
            control-plane: controller-manager
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - operator
                - --kcp-namespace=platform-mesh-system
                - --kcp-front-proxy-port=443
                - --leader-elect
                - --metrics-bind-address=:9090
                - --health-probe-bind-address=:8090
                - --log-level=warn
                - --region=
                - --environment=
                - --image-tag=1.0.0
                - --image-name="ghcr.io/platform-mesh/platform-mesh/provider-operator"
                - --shutdown-timeout=1m
                - --max-concurrent-reconciles=10
              env: null
              image: ghcr.io/platform-mesh/platform-mesh/provider-operator:1.0.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 1
                httpGet:
                  path: /healthz
                  port: 8090
                periodSeconds: 10
              name: provider-operator
              ports:
                - containerPort: 9090
                  name: metrics
                  protocol: TCP
                - containerPort: 8090
                  name: health-port
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 8090
                initialDelaySeconds: 5
                periodSeconds: 10
              resources:
                limits:
                  memory: 512Mi
                requests:
                  cpu: 40m
                  memory: 50Mi
              securityContext:
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /readyz
                  port: 8090
                periodSeconds: 10
              volumeMounts: null
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: provider-operator
          terminationGracePeriodSeconds: 10
          volumes: null
  4: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app: provider-operator
      name: provider-operator-metrics
    spec:
      ports:
        - name: metrics
          port: 9090
          protocol: TCP
          targetPort: metrics
      selector:
        app: provider-operator
      type: ClusterIP
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: provider-operator
      namespace: platform-mesh-system
    rules:
      - apiGroups:
          - coordination.k8s.io
        resources:
          - leases
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - ""
        resources:
          - events
        verbs:
          - create
          - patch
  6: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: provider-operator
      namespace: platform-mesh-system
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: provider-operator
    subjects:
      - kind: ServiceAccount
        name: provider-operator
        namespace: platform-mesh-system
  7: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: provider-operator
      namespace: platform-mesh-system
