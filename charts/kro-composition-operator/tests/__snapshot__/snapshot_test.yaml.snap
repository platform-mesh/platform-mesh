match snapshot:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kro-composition-operator
        helm.sh/chart: kro-composition-operator-1.0.0
      name: kro-composition-operator
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/name: kro-composition-operator
      template:
        metadata:
          labels:
            app.kubernetes.io/name: kro-composition-operator
        spec:
          containers:
            - args:
                - --kubeconfig=/kubeconfig/kubeconfig
                - --provider-workspace=root:providers:kro-provider
                - --apiexport-endpointslice=kro.run
                - --health-probe-bind-address=:8081
                - --leader-elect
              image: ghcr.io/platform-mesh/platform-mesh/kro-composition-operator:1.0.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: 8081
                initialDelaySeconds: 15
              name: manager
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 8081
                initialDelaySeconds: 5
              resources:
                limits:
                  memory: 256Mi
                requests:
                  cpu: 50m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
              volumeMounts:
                - mountPath: /kubeconfig
                  name: kubeconfig
                  readOnly: true
          securityContext:
            runAsNonRoot: true
          serviceAccountName: kro-composition-operator
          volumes:
            - name: kubeconfig
              secret:
                secretName: kcp-kubeconfig
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kro-composition-operator
        helm.sh/chart: kro-composition-operator-1.0.0
      name: kro-composition-operator-leaderelection
    rules:
      - apiGroups:
          - coordination.k8s.io
        resources:
          - leases
        verbs:
          - get
          - list
          - watch
          - create
          - update
          - patch
          - delete
      - apiGroups:
          - ""
        resources:
          - events
        verbs:
          - create
          - patch
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kro-composition-operator
        helm.sh/chart: kro-composition-operator-1.0.0
      name: kro-composition-operator-leaderelection
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: kro-composition-operator-leaderelection
    subjects:
      - kind: ServiceAccount
        name: kro-composition-operator
        namespace: NAMESPACE
  4: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kro-composition-operator
        helm.sh/chart: kro-composition-operator-1.0.0
      name: kro-composition-operator
