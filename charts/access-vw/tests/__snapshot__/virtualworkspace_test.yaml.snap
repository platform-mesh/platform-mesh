matches snapshot (defaults, provider openfga):
  1: |
    apiVersion: gateway.platform-mesh.io/v1alpha1
    kind: ClusterAccess
    metadata:
      labels:
        app: access-vw
        app.kubernetes.io/instance: access-vw
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: access-vw
        helm.sh/chart: access-vw-0.0.0
      name: access
    spec:
      auth:
        kubeconfigSecretRef:
          key: kubeconfig
          name: access-vw-clusteraccess-kubeconfig
          namespace: platform-mesh-system
      introspectionPath: /clusters/*
      requestPathTemplate: /clusters/{clusterTarget}
  2: |
    apiVersion: operator.kcp.io/v1alpha1
    kind: VirtualWorkspace
    metadata:
      labels:
        app: access-vw
        app.kubernetes.io/instance: access-vw
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: access-vw
        helm.sh/chart: access-vw-0.0.0
      name: access-vw
      namespace: platform-mesh-system
    spec:
      command:
        - /access-vw
      external:
        hostname: kcp.api.example.com
        port: 8443
      extraArgs:
        - --provider=openfga
        - --openfga-addr=openfga.platform-mesh-system.svc.cluster.local:8081
        - --openfga-relation=get
        - --openfga-object-type=core_platform-mesh_io_account
        - --openfga-orgs-workspace=root:orgs
        - --openfga-accounts-endpointslice=core.platform-mesh.io
        - --openfga-stores-endpointslice=openfga.platform-mesh.io
        - --endpoint-base=https://kcp.api.example.com:8443/clusters/
      image:
        repository: ghcr.io/platform-mesh/platform-mesh/access-virtual-workspaces
        tag: 0.1.1
      kubeconfigSecretRef:
        name: access-vw-kubeconfig
      replicas: 1
      resources:
        limits:
          memory: 512Mi
        requests:
          cpu: 100m
          memory: 128Mi
      target:
        rootShardRef:
          name: root
matches snapshot (provider rbac):
  1: |
    apiVersion: gateway.platform-mesh.io/v1alpha1
    kind: ClusterAccess
    metadata:
      labels:
        app: access-vw
        app.kubernetes.io/instance: access-vw
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: access-vw
        helm.sh/chart: access-vw-0.0.0
      name: access
    spec:
      auth:
        kubeconfigSecretRef:
          key: kubeconfig
          name: access-vw-clusteraccess-kubeconfig
          namespace: platform-mesh-system
      introspectionPath: /clusters/*
      requestPathTemplate: /clusters/{clusterTarget}
  2: |
    apiVersion: operator.kcp.io/v1alpha1
    kind: Kubeconfig
    metadata:
      labels:
        app: access-vw
        app.kubernetes.io/instance: access-vw
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: access-vw
        helm.sh/chart: access-vw-0.0.0
      name: access-vw-bootstrap
      namespace: platform-mesh-system
    spec:
      groups:
        - system:kcp:admin
      secretRef:
        name: access-vw-bootstrap-kubeconfig
      target:
        frontProxyRef:
          name: frontproxy
      username: kcp-admin
      validity: 8766h
  3: |
    apiVersion: operator.kcp.io/v1alpha1
    kind: Kubeconfig
    metadata:
      labels:
        app: access-vw
        app.kubernetes.io/instance: access-vw
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: access-vw
        helm.sh/chart: access-vw-0.0.0
      name: access-vw-server
      namespace: platform-mesh-system
    spec:
      secretRef:
        name: access-vw-server-kubeconfig
      target:
        frontProxyRef:
          name: frontproxy
      targetWorkspace: root:access:controllers
      username: access-vw
      validity: 8766h
  4: |
    apiVersion: operator.kcp.io/v1alpha1
    kind: VirtualWorkspace
    metadata:
      labels:
        app: access-vw
        app.kubernetes.io/instance: access-vw
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: access-vw
        helm.sh/chart: access-vw-0.0.0
      name: access-vw
      namespace: platform-mesh-system
    spec:
      command:
        - /access-vw
      external:
        hostname: kcp.api.example.com
        port: 8443
      extraArgs:
        - --provider=rbac
        - --apiexport-endpointslice=access.platform-mesh.io
        - --endpoint-base=https://kcp.api.example.com:8443/clusters/
      image:
        repository: ghcr.io/platform-mesh/platform-mesh/access-virtual-workspaces
        tag: 0.1.1
      initContainers:
        - args:
            - --kubeconfig=/etc/kcp/init-kubeconfig/kubeconfig
            - --workspace-prefix=root:access
            - --controllers-workspace=controllers
            - --server-user=access-vw
          command:
            - /access-vw-init
          kubeconfigSecretRef:
            name: access-vw-bootstrap-kubeconfig
          name: init
      kubeconfigSecretRef:
        name: access-vw-server-kubeconfig
      replicas: 1
      resources:
        limits:
          memory: 512Mi
        requests:
          cpu: 100m
          memory: 128Mi
      target:
        rootShardRef:
          name: root
