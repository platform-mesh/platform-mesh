HTTPRoute matches snapshot:
  1: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      name: kubernetes-graphql-gateway
      namespace: platform-mesh-system
    spec:
      parentRefs:
        - name: k8sapi-gateway
      rules:
        - backendRefs:
            - name: kubernetes-graphql-gateway
              namespace: platform-mesh-system
              port: 8080
          filters:
            - type: URLRewrite
              urlRewrite:
                path:
                  replacePrefixMatch: /api/clusters/
                  type: ReplacePrefixMatch
          matches:
            - path:
                type: PathPrefix
                value: /gateway/api/clusters/
