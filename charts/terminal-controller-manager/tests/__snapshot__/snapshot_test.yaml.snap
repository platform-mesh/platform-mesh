match the default snapshot:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: terminal-controller-manager
    spec:
      replicas: 1
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app: terminal-controller-manager
      template:
        metadata:
          annotations: null
          labels:
            app: terminal-controller-manager
            control-plane: controller-manager
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - operator
                - --leader-elect
                - --metrics-bind-address=:9090
                - --health-probe-bind-address=:8090
                - --log-level=warn
                - --region=
                - --environment=
                - --image-tag=0.0.0
                - --image-name="ghcr.io/platform-mesh/platform-mesh/terminal-controller-manager"
                - --shutdown-timeout=1m
                - --max-concurrent-reconciles=10
                - --kcp-api-export-endpoint-slice-name=terminal.platform-mesh.io
                - --terminal-image=ghcr.io/platform-mesh/platform-mesh/terminal:0.0.0
                - --terminal-namespace=terminal-sessions
                - --terminal-lifetime=2h
                - --gateway-name=k8sapi-gateway
                - --gateway-namespace=platform-mesh-system
                - --subroutines-lifetime-enabled=true
                - --subroutines-pod-enabled=true
                - --subroutines-service-enabled=true
                - --subroutines-httproute-enabled=true
              env: null
              image: ghcr.io/platform-mesh/platform-mesh/terminal-controller-manager:0.0.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 1
                httpGet:
                  path: /healthz
                  port: 8090
                periodSeconds: 10
              name: terminal-controller-manager
              ports:
                - containerPort: 9090
                  name: metrics
                  protocol: TCP
                - containerPort: 8090
                  name: health-port
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 8090
                initialDelaySeconds: 5
                periodSeconds: 10
              resources:
                limits:
                  memory: 512Mi
                requests:
                  cpu: 40m
                  memory: 50Mi
              securityContext:
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /readyz
                  port: 8090
                periodSeconds: 10
              volumeMounts: null
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: terminal-controller-manager
          terminationGracePeriodSeconds: 10
          volumes: null
  2: |
    apiVersion: v1
    kind: Namespace
    metadata:
      labels:
        app.kubernetes.io/managed-by: terminal-controller-manager
      name: terminal-sessions
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: terminal-controller-manager
      namespace: terminal-sessions
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - create
          - delete
          - get
          - list
          - watch
      - apiGroups:
          - ""
        resources:
          - services
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - gateway.networking.k8s.io
        resources:
          - httproutes
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - ""
        resources:
          - events
        verbs:
          - create
          - update
          - patch
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: terminal-controller-manager-leader-election
    rules:
      - apiGroups:
          - coordination.k8s.io
        resources:
          - leases
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: terminal-controller-manager
      namespace: terminal-sessions
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: terminal-controller-manager
    subjects:
      - kind: ServiceAccount
        name: terminal-controller-manager
        namespace: platform-mesh-system
  6: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: terminal-controller-manager-leader-election
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: terminal-controller-manager-leader-election
    subjects:
      - kind: ServiceAccount
        name: terminal-controller-manager
        namespace: platform-mesh-system
  7: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: terminal-controller-manager
